{
  "type": "object",
  "properties": {
    "dataSources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "PrimaryDB"
            ]
          },
          "type": {
            "type": "string",
            "examples": [
              "db"
            ]
          },
          "connectionDetails": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "examples": [
                  "PostgreSQL"
                ]
              },
              "host": {
                "type": "string",
                "examples": [
                  "localhost"
                ]
              },
              "port": {
                "type": "string",
                "examples": [
                  "5439"
                ]
              },
              "userName": {
                "type": "string",
                "examples": [
                  "iot_manager"
                ]
              },
              "password": {
                "type": "string",
                "examples": [
                  "qwe123"
                ]
              },
              "connectionString": {
                "type": "string",
                "examples": [
                  "jdbc:postgresql://localhost:5432/iot_devices"
                ]
              }
            },
            "required": [
              "type",
              "host",
              "port",
              "userName",
              "password",
              "connectionString"
            ]
          }
        },
        "required": [
          "name",
          "type",
          "connectionDetails"
        ]
      }
    },
    "searchConfig": {
      "type": "object",
      "properties": {
        "searchOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "examples": [
                  "Search by Id"
                ]
              },
              "dataSource": {
                "type": "string",
                "examples": [
                  "PrimaryDB"
                ]
              },
              "businessEntityType": {
                "type": "string",
                "examples": [
                  "devices"
                ]
              },
              "request": {
                "type": "string",
                "examples": [
                  "SELECT d.* FROM devices.devices AS d WHERE d.id=?"
                ]
              },
              "searchParameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "examples": [
                        "id"
                      ]
                    },
                    "title": {
                      "type": "string",
                      "examples": [
                        "Id"
                      ]
                    },
                    "type": {
                      "type": "string",
                      "examples": [
                        "long"
                      ]
                    },
                    "parameterId": {
                      "type": "integer",
                      "examples": [
                        1
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "title",
                    "type",
                    "parameterId"
                  ]
                }
              }
            },
            "required": [
              "name",
              "dataSource",
              "businessEntityType",
              "request",
              "searchParameters"
            ]
          }
        }
      },
      "required": [
        "searchOptions"
      ]
    },
    "childEntities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "businessEntityType": {
            "type": "string",
            "examples": [
              "locations"
            ]
          },
          "searchDetails": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "businessEntityType": {
                  "type": "string",
                  "examples": [
                    "devices"
                  ]
                },
                "dataSource": {
                  "type": "string",
                  "examples": [
                    "PrimaryDB"
                  ]
                },
                "request": {
                  "type": "string",
                  "examples": [
                    "SELECT d.id, d.name, dt.name as device_type FROM devices.devices AS d join devices.device_types dt on dt.id = d.device_type_id WHERE d.location_id = ?"
                  ]
                }
              },
              "required": [
                "businessEntityType",
                "dataSource",
                "request"
              ]
            }
          }
        },
        "required": [
          "businessEntityType",
          "searchDetails"
        ]
      }
    },
    "businessEntityConfig": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "businessEntityType": {
            "type": "string",
            "examples": [
              "devices"
            ]
          },
          "attributes": {
            "type": "object",
            "properties": {
              "dataSource": {
                "type": "string",
                "examples": [
                  "PrimaryDB"
                ]
              },
              "request": {
                "type": "string",
                "examples": [
                  "SELECT d.* FROM devices.devices d where d.id=?"
                ]
              }
            },
            "required": [
              "dataSource",
              "request"
            ]
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "examples": [
                    "Restart device"
                  ]
                },
                "script": {
                  "type": "string",
                  "examples": [
                    "restartDevice.groovy"
                  ]
                }
              },
              "required": [
                "name",
                "script"
              ]
            }
          }
        },
        "required": [
          "businessEntityType",
          "attributes",
          "actions"
        ]
      }
    }
  },
  "required": [
    "dataSources",
    "searchConfig",
    "childEntities",
    "businessEntityConfig"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}