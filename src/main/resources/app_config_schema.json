{
  "type": "object",
  "properties": {
    "searchConfig": {
      "type": "object",
      "properties": {
        "searchOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "examples": [
                  "Search by Id"
                ]
              },
              "dataSource": {
                "type": "string",
                "examples": [
                  "PrimaryDB"
                ]
              },
              "businessEntityType": {
                "type": "string",
                "examples": [
                  "devices"
                ]
              },
              "requestScript": {
                "type": "null"
              },
              "request": {
                "type": "string",
                "examples": [
                  "SELECT d.* FROM devices.devices AS d WHERE d.id=?"
                ]
              },
              "requestEditable": {
                "type": "boolean",
                "examples": [
                  false
                ]
              },
              "searchParameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "examples": [
                        "id"
                      ]
                    },
                    "title": {
                      "type": "string",
                      "examples": [
                        "Id"
                      ]
                    },
                    "type": {
                      "type": "string",
                      "examples": [
                        "long"
                      ]
                    },
                    "parameterId": {
                      "type": "integer",
                      "examples": [
                        1
                      ]
                    },
                    "defaultValue": {
                      "type": "string",
                      "examples": [
                        "10"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "title",
                    "type",
                    "parameterId",
                    "defaultValue"
                  ]
                }
              }
            },
            "required": [
              "name",
              "dataSource",
              "businessEntityType",
              "requestScript",
              "request",
              "requestEditable",
              "searchParameters"
            ]
          }
        }
      },
      "required": [
        "searchOptions"
      ]
    },
    "businessEntityRelations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "businessEntityType": {
            "type": "string",
            "examples": [
              "locations"
            ]
          },
          "childEntities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "businessEntityType": {
                  "type": "string",
                  "examples": [
                    "devices"
                  ]
                },
                "dataSource": {
                  "type": "string",
                  "examples": [
                    "PrimaryDB"
                  ]
                },
                "request": {
                  "type": "string",
                  "examples": [
                    "SELECT d.id, d.name, dt.name as device_type, 'lightbulb.png' as h_icon FROM devices.devices AS d join devices.device_types dt on dt.id = d.device_type_id WHERE d.location_id = ?"
                  ]
                },
                "parentReference": {
                  "type": "string",
                  "examples": [
                    "id"
                  ]
                },
                "parentReferenceType": {
                  "type": "string",
                  "examples": [
                    "long"
                  ]
                }
              },
              "required": [
                "businessEntityType",
                "dataSource",
                "request",
                "parentReference",
                "parentReferenceType"
              ]
            }
          }
        },
        "required": [
          "businessEntityType",
          "childEntities"
        ]
      }
    },
    "businessEntityConfig": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "businessEntityType": {
            "type": "string",
            "examples": [
              "devices"
            ]
          },
          "dataSource": {
            "type": "string",
            "examples": [
              "PrimaryDB"
            ]
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "displayName": {
                  "type": "string",
                  "examples": [
                    "attributes"
                  ]
                },
                "dataSource": {
                  "type": "string",
                  "examples": [
                    "PrimaryDB"
                  ]
                },
                "request": {
                  "type": "string",
                  "examples": [
                    "SELECT d.*, 'lightbulb.png' as h_icon FROM devices.devices d where d.id=?"
                  ]
                },
                "reference": {
                  "type": "string",
                  "examples": [
                    "id"
                  ]
                },
                "referenceType": {
                  "type": "string",
                  "examples": [
                    "long"
                  ]
                }
              },
              "required": [
                "displayName",
                "dataSource",
                "request",
                "reference",
                "referenceType"
              ]
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "examples": [
                    "Restart device"
                  ]
                },
                "toolTip": {
                  "type": "string",
                  "examples": [
                    "Restart selected device"
                  ]
                },
                "type": {
                  "type": "string",
                  "examples": [
                    "script"
                  ]
                },
                "script": {
                  "type": "string",
                  "examples": [
                    "scripts/restartDevice.groovy"
                  ]
                },
                "reference": {
                  "type": "string",
                  "examples": [
                    "id"
                  ]
                },
                "referenceType": {
                  "type": "string",
                  "examples": [
                    "long"
                  ]
                }
              },
              "required": [
                "name",
                "toolTip",
                "type",
                "script",
                "reference",
                "referenceType"
              ]
            }
          }
        },
        "required": [
          "businessEntityType",
          "dataSource",
          "details",
          "actions"
        ]
      }
    }
  },
  "required": [
    "searchConfig",
    "businessEntityRelations",
    "businessEntityConfig"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}